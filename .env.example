# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (Required MongoDB Atlas Connection URI)
MONGODB_URI=your_mongodb_atlas_uri_here

# Security
JWT_SECRET=your_jwt_secret_here

# Timezone & Retention Window Policy
APP_TIMEZONE=Asia/Kolkata
RETENTION_DAYS=32
MAX_UPLOAD_SIZE=5242880

# Frontend & CORS Configuration (Optional)
# If backend is hosted separately from frontend (e.g. Render / Railway):
# VITE_API_URL=https://your-backend-api.com
# FRONTEND_URL=https://erp-delivery-five.vercel.app

